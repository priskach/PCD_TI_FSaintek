        "# 'luispedro' adalah contoh gambar default (foto orang)\n",
        "# as_grey=True → konversi ke grayscale agar mudah diproses\n",
        "image = mahotas.demos.load('luispedro', as_grey=True)\n",
        "\n",
        "# Menampilkan gambar menggunakan Matplotlib\n",
        "plt.imshow(image, cmap='gray')\n",
